# API Configuration
API_HOST=localhost
API_PORT=8000
API_WORKERS=1

# Model Configuration
MODEL_NAME=microsoft/DialoGPT-medium
MODEL_CACHE_DIR=./models
MAX_TOKENS=4096
TEMPERATURE=0.7
TOP_P=0.9

# Code Analysis
SUPPORTED_LANGUAGES=python,javascript,typescript,java,cpp,rust,go
MAX_FILE_SIZE=1048576  # 1MB
MAX_CONTEXT_FILES=50

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
API_KEY_REQUIRED=false
ALLOWED_ORIGINS=*

# Performance
BATCH_SIZE=8
GPU_ENABLED=false
DEVICE=cpu

# Development
DEBUG=false
RELOAD=true